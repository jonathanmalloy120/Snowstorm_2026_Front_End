# --- Signals (Console > Signals > Overview) ---
SIGNALS_API_URL=https://<id>.signals.snowplowanalytics.com
SIGNALS_API_KEY=
SIGNALS_API_KEY_ID=
SIGNALS_ORG_ID=01d8adee-66d5-4cdd-a694-cc57b829a70a

# --- Iglu coordinates, confirmed against Console DEV 1-0-0 ---
ARTICLE_ENTITY_VENDOR=com.snowplowanalytics
ARTICLE_ENTITY_NAME=article
ARTICLE_ENTITY_MAJOR_VERSION=2
INTERACTION_EVENT_VENDOR=com.snowplowanalytics
INTERACTION_EVENT_NAME=article_interaction
INTERACTION_EVENT_VERSION=1-0-0
INTERACTION_TYPE_PATH=interaction_type

# --- Poller ---
APP_IDS=snowstorm-2026-publisher
POLL_INTERVAL_SECONDS=60
ID_CHUNK_SIZE=50
DATABASE_URL=postgresql://snowstorm:snowstorm@localhost:5433/snowstorm

# Must match enableActivityTracking() in the publisher repo.
HEARTBEAT_DELAY_SECONDS=10
MINIMUM_VISIT_LENGTH_SECONDS=10

ARTICLE_VIEW_EVENT_VENDOR=com.snowplowanalytics
ARTICLE_VIEW_EVENT_NAME=article_view
ARTICLE_VIEW_EVENT_VERSION=1-0-0
INTERACTION_TYPES=like,bookmark,favorite,share
